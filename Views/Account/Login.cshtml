@model SchoolLibrary.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Log in";
}

<section class="auth-panel">
    <h1>You haven't logged into an account.</h1>

    <form asp-controller="Account" asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>

        <div class="field">
            <label asp-for="UsernameOrEmail"></label>
            <input asp-for="UsernameOrEmail"
                   autocomplete="username"
                   required />
            <span asp-validation-for="UsernameOrEmail" class="validation"></span>
        </div>

        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password"
                   type="password"
                   autocomplete="current-password"
                   required />
            <span asp-validation-for="Password" class="validation"></span>
        </div>

        <div class="field">
            <label asp-for="RememberMe">Remember me</label>
            <input asp-for="RememberMe" type="checkbox" />
        </div>

        <div class="form-bottom">
            <button type="submit">Log in</button>

            <p>
                Don't have an account?<br />
                <a asp-action="Register">Create one here.</a>
            </p>
        </div>
    </form>
</section>