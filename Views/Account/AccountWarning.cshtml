@{ ViewData["Title"] = "Account"; }
<section class="account-warning">
    <h1>You haven't logged into an account.</h1>
    <div class="warning-actions">
        <a class="button" asp-controller="Account" asp-action="Login">Log in</a>
        <a class="button" asp-controller="Account" asp-action="Register">Register</a>
    </div>
</section>
